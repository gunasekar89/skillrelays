# Pick one provider. Leave all blank to run in simulated mode (no AI calls, no cost).
# AI_PROVIDER=auto        # auto | azure | openai | simulated

# Azure OpenAI (works with Azure for Students credit if your subscription allows Azure OpenAI)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Or OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
