# Copy to .env.local and fill in ONE AI tool. .env.local is git-ignored.
# Keys are read only by the dev server's /api/ask endpoint, never sent to the browser.
# Restart `npm run dev` after changing this file.

# Optional: force a provider when several are set (azure | openai | anthropic)
# AI_PROVIDER=azure

# Azure OpenAI (recommended for the Azure deployment)
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
